[all:children]
prod
dev

# adjust the hostnames and IP addresses according to your setup
[prod]
prod1 ansible_host=192.168.x.x ansible_connection=ssh ansible_user=ubuntu
prod2 ansible_host=192.168.x.x ansible_connection=ssh ansible_user=ubuntu

# adjust the hostnames and IP addresses according to your setup
[dev]
dev1 ansible_host=192.168.x.x ansible_connection=ssh ansible_user=ubuntu
dev2 ansible_host=192.168.x.x ansible_connection=ssh ansible_user=ubuntu

[all:vars]
ansible_python_interpreter=/usr/bin/python3